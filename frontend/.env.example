# Server-side only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated, no limit on the number of keys. If a key hits its limit, the next key is used.
OPENROUTER_API_KEY=key1,key2,key3
# Comma-separated, tried one at a time in order. Only ":free" models (and openrouter/free) are used; paid ones are ignored.
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,openai/gpt-oss-120b:free,meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free,openrouter/free
# Fallback when every OpenRouter key/model fails. Free key from aistudio.google.com. Comma-separated, any number of keys.
GEMINI_API_KEY=
# Optional, comma-separated, tried in order. Default: gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-latest,gemini-flash-lite-latest
GEMINI_MODELS=
# Encrypts citizen profile + activity rows (lib/crypto.ts). base64 of 32 random bytes.
# Every teammate must use the SAME key (data encrypted with one key cannot be read with another).
DATA_ENCRYPTION_KEY=

# Push to phones with the app closed (Firebase Cloud Messaging). Firebase console > Project settings > Service accounts >
# Generate new private key; paste the JSON on ONE line, or its base64. Leave empty to rely on in-app polling only.
FIREBASE_SERVICE_ACCOUNT=

# Face login (computer_vision/face_service.py). The CV service must run on the SAME host, 127.0.0.1 only.
# CV_API_KEY: long random string, identical in the CV service's environment.
CV_SERVICE_URL=https://api-siagaku.felixfanady.com
CV_API_KEY=
# SFace cosine, clamped to 0.363..0.7. Higher = fewer false accepts, more "coba lagi".
FACE_MATCH_THRESHOLD=0.42
# 1 = my-reports / notices require the face token (turn on after the new app build is installed).
FACE_AUTH_ENFORCE=0
STAFF_FACE_REQUIRED=1
STAFF_FACE_EXEMPT=admin@siagaku.gov
LOGIN_GEOIP=1
